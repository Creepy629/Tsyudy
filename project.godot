config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Tsyudy"
config/name_localized={
"en": "Tsyudy"
}
config/version="0.3.0"
run/main_scene="uid://dd42glf16hysr"
config/features=PackedStringArray("4.6")
boot_splash/bg_color=Color(0.143137, 0.130872, 0.185239, 1)
boot_splash/image="uid://02m27yyrogqv"
config/icon="uid://02m27yyrogqv"

[autoload]

GameManager="*res://Código/Sistema/GameManager.gd"
Hitstop="*res://Código/Pelea/Hitstop.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=480
window/size/resizable=false
window/stretch/mode="canvas_items"
window/stretch/aspect="ignore"

[dotnet]

project/assembly_name="UntitledMexicanGame"

[importer_defaults]

animation_library={
&"blender/meshes/colors": true,
&"blender/meshes/export_geometry_nodes_instances": true,
&"blender/meshes/gpu_instances": true
}

